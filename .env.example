# Copie para .env.local e preencha apenas no seu computador.
# Na Vercel, configure os valores em Settings > Environment Variables.
JWT_SECRET=
OAUTH_STATE_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere 32 bytes aleatórios em base64; esta chave cifra refresh tokens no banco.
DRIVE_TOKEN_ENCRYPTION_KEY=
# E-mails autorizados a abrir o painel privado de moderação, separados por vírgula.
ADMIN_EMAILS=
# Marketing e transparência. O Analytics só carrega após consentimento explícito.
NEXT_PUBLIC_SITE_URL=https://finance-app-indol-alpha.vercel.app
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# Envio automático dos convites de equipe (opcional; o link copiável continua disponível).
RESEND_API_KEY=
TEAM_INVITE_FROM="CandTech <convites@candtech.com.br>"
