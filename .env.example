# Copie para .env.local e preencha apenas no seu computador.
# Na Vercel, configure os valores em Settings > Environment Variables.
JWT_SECRET=
OAUTH_STATE_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere 32 bytes aleatórios em base64; esta chave cifra refresh tokens no banco.
DRIVE_TOKEN_ENCRYPTION_KEY=
# Gere outra chave independente de 32 bytes em Base64 para cifrar segredos TOTP.
MFA_ENCRYPTION_KEY=
# Administradores principais, separados por vírgula. Eles possuem todos os
# módulos e são os únicos que concedem/revogam acessos da equipe interna.
ADMIN_EMAILS=
# Opcional: caminho secreto da central (24 a 80 caracteres). Se vazio, o servidor
# gera um endereço estável a partir de JWT_SECRET, sem publicá-lo no código.
ADMIN_MONITORING_SLUG=
# Contato exibido publicamente na aba Suporte.
NEXT_PUBLIC_SUPPORT_EMAIL=rennerecriss@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE="+55 11 94333-5740"
# Marketing e transparência. O Analytics só carrega após consentimento explícito.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-N6Y3ZWJVVT
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# Pix manual. A chave é entregue somente a usuários autenticados; não use NEXT_PUBLIC_.
PIX_KEY=
PIX_RECEIVER_NAME=CANDTECH
PIX_RECEIVER_CITY=MAIRINQUE
PIX_MONTHLY_AMOUNT_CENTS=6000
PIX_SETUP_AMOUNT_CENTS=12000
PIX_PAYMENT_TTL_HOURS=72
# Store privado conectado ao projeto na Vercel. O token é somente de servidor.
# Em deployments Vercel, OIDC + BLOB_STORE_ID também podem ser usados pelo SDK.
BLOB_READ_WRITE_TOKEN=
# Protege o processamento diário de expiração e envio de backup.
CRON_SECRET=
# Ative somente depois de configurar o Pix e testar aprovação, expiração e backup. Quando true,
# as APIs operacionais exigem assinatura ativa; cadastro, aceite e pagamento continuam acessíveis.
BILLING_ENFORCEMENT_ENABLED=false
# Envio automático dos convites de equipe (opcional; o link copiável continua disponível).
# TEAM_INVITE_FROM precisa usar um domínio remetente verificado no Resend.
RESEND_API_KEY=
TEAM_INVITE_FROM="CandTech <convites@candtech.com.br>"
# Opcional: remetente específico para confirmação e recuperação de acesso.
# Se ficar vazio, o sistema reutiliza TEAM_INVITE_FROM.
AUTH_EMAIL_FROM="CandTech <acesso@candtech.com.br>"
# URL usada nos links enviados por e-mail. Em produção, use o domínio canônico.
PUBLIC_APP_URL=https://candtech.com.br
