# Copie para .env.local e preencha apenas no seu computador.
# Na Vercel, configure os valores em Settings > Environment Variables.
JWT_SECRET=
OAUTH_STATE_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere 32 bytes aleatórios em base64; esta chave cifra refresh tokens no banco.
DRIVE_TOKEN_ENCRYPTION_KEY=
# E-mails autorizados a abrir o painel privado de moderação, separados por vírgula.
ADMIN_EMAILS=
# Marketing e transparência. O Analytics só carrega após consentimento explícito.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-HTLEL8WXMV
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# Mercado Pago: use credenciais de teste no Preview e de produção somente no Production.
# ACCESS_TOKEN e WEBHOOK_SECRET são segredos de servidor e devem ser Sensitive na Vercel.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PLAN_ID=
# Envio automático dos convites de equipe (opcional; o link copiável continua disponível).
# TEAM_INVITE_FROM precisa usar um domínio remetente verificado no Resend.
RESEND_API_KEY=
TEAM_INVITE_FROM="CandTech <convites@candtech.com.br>"
# Opcional: remetente específico para confirmação e recuperação de acesso.
# Se ficar vazio, o sistema reutiliza TEAM_INVITE_FROM.
AUTH_EMAIL_FROM="CandTech <acesso@candtech.com.br>"
# URL usada nos links enviados por e-mail. Em produção, use o domínio canônico.
PUBLIC_APP_URL=https://candtech.com.br
